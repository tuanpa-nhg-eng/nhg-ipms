# NHG iPMS — biến môi trường dev (copy thành .env — KHÔNG commit .env)
# Runtime app: role ipms_app (RLS enforce)
DATABASE_URL="postgresql://ipms_app:ipms_app_dev_only@localhost:55432/ipms?schema=public"
# Migration/seed/test-setup: role owner (bypass RLS như table owner)
OWNER_DATABASE_URL="postgresql://ipms_owner:ipms_dev_only@localhost:55432/ipms?schema=public"

# Dev auth (Phase 0 — thay bằng Entra ID OIDC ở phase sau)
ALLOW_DEV_TOKEN=true
DEV_JWT_SECRET=ipms-dev-secret-do-not-use-in-prod
# Chỉ local dev: cho phép fallback secret khi DEV_JWT_SECRET không set (fail-closed mặc định)
ALLOW_INSECURE_DEV_SECRET=false

PORT=4000
REDIS_URL="redis://localhost:56379"
