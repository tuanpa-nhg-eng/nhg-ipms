  type            String // 'org_change'|'derivation_rule'|'process'...
  payload         Json
  reason          String? // explainable — vì sao AI đề xuất
  status          String  @default("pending") // pending|accepted|rejected
  createdByTool   String? @map("created_by_tool")
  decidedBy       String? @map("decided_by") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote    String? @map("decision_note")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, status])
  @@map("ai_suggestion")
}

// [Learning Loop L0] Tín hiệu học từ quyết định NGƯỜI THẬT trên ai_suggestion —
// APPEND-ONLY như ai_interaction (trigger chặn UPDATE/DELETE kể cả owner).
// outcome: accepted | accepted_with_edits | rejected | expired (CHECK ở migration).
// edited_fields = diff proposed↔final (dotted 1 tầng, vd 'fill.aiLevel') — "AI sai chỗ nào".
model AiLearningSignal {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  suggestionId    String   @map("suggestion_id") @db.Uuid
  agent           String // createdByTool của suggestion, vd 'inline.taskcell.draft'
  outcome         String
  proposedPayload Json?    @map("proposed_payload")
  finalPayload    Json?    @map("final_payload")
  editedFields    Json?    @map("edited_fields") // string[] — null khi không xác định được
  actorUserId     String?  @map("actor_user_id") @db.Uuid // null = hệ thống (expire job)
  at              DateTime @default(now()) @db.Timestamptz(6)

  goldenCandidates AiGoldenCandidate[] // [F162] harvest lọc "chưa có candidate" ngay trong query

  @@index([tenantId, agent, outcome])
  @@index([tenantId, suggestionId])
  @@map("ai_learning_signal")
}

// [Learning Loop L1] Ứng viên golden case — thu hoạch từ tín hiệu accepted(_with_edits),
// curator DUYỆT mới thành ai_eval_case (suite 'golden-learned'). SoD trên THƯỚC ĐO:
// người duyệt ≠ người tạo tín hiệu (source_actor_user_id) — chặn cả admin, có incident audit.
// input = {task, agent, prompt, context} — replay TẤT ĐỊNH qua ai-gateway, không phụ DB.
model AiGoldenCandidate {
  id                String    @id @db.Uuid
  tenantId          String    @map("tenant_id") @db.Uuid
  signalId          String    @map("signal_id") @db.Uuid
  suggestionId      String    @map("suggestion_id") @db.Uuid
  agent             String
  sourceActorUserId String?   @map("source_actor_user_id") @db.Uuid
  input             Json
  expected          Json // proposal-shaped: finalPayload (người dùng đã sửa) ?? proposedPayload
  status            String    @default("proposed") // proposed|approved|rejected
  caseId            String?   @map("case_id") @db.Uuid // ai_eval_case sinh ra khi approve
  decidedBy         String?   @map("decided_by") @db.Uuid
  decidedAt         DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote      String?   @map("decision_note")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  signal AiLearningSignal @relation(fields: [signalId], references: [id]) // [F162]

  @@unique([tenantId, signalId])
  @@index([tenantId, status])
  @@map("ai_golden_candidate")
}

// [Learning Loop L2] Launch bar per agent (AI-Native PRD §14) — ngưỡng eval tối thiểu
// để coi agent "đủ tốt để CÂN NHẮC bật live" (điều kiện CẦN, không tự bật gì).
// Config-as-data đơn giản: PUT có audit; readiness fail-closed khi thiếu bar/run.
model AiLaunchBar {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  agent       String
  minPassRate Decimal @map("min_pass_rate") @db.Decimal(4, 3) // (0..1]
  minCases    Int     @map("min_cases")
  note        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, agent])
  @@map("ai_launch_bar")
}

// [Learning Loop L3] Bảng giá model (AI-Native PRD §16 unit economics) — catalog
// GLOBAL (tenant_id NULL, chuẩn F44: app CHỈ ĐỌC, seed/B3 cập nhật). Giá niêm yết
// Anthropic per 1M token; mock = 0. Projection chi phí là ƯỚC LƯỢNG minh bạch.
model AiModelPrice {
  id                String  @id @db.Uuid
  tenantId          String? @map("tenant_id") @db.Uuid // NULL = global catalog
  model             String
  inputUsdPerMTok   Decimal @map("input_usd_per_mtok") @db.Decimal(10, 4)
  outputUsdPerMTok  Decimal @map("output_usd_per_mtok") @db.Decimal(10, 4)
  note              String?
  asOf              String? @map("as_of") // ngày niêm yết tham chiếu (vd '2026-06-24')
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("ai_model_price")
}

// [Last-mile Lát 2] ai_egress_policy — tenant CHẶN THÊM egress theo (dataClass, destination)
// (thu hẹp, không mở rộng — bất biến pii/confidential⇒mock-only nằm trong CODE, không đọc
// bảng này). Không có row ⇒ mặc định cho phép cho public/internal (đã qua cổng flag+key).
model AiEgressPolicy {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  dataClass   String  @map("data_class") // public|internal|confidential|pii
  destination String // mock|anthropic|self_host
  allowed     Boolean @default(false)
  note        String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, dataClass, destination])
  @@index([tenantId])
  @@map("ai_egress_policy")
}

// [Last-mile Lát 4] Model ĐANG PHỤC VỤ 1 agent khi live — pin tường minh, đổi PHẢI qua
// EvalService.setServingModel() (chỉ chấp nhận khi có qualification hợp lệ, chưa hết
// hạn, đạt bar hiện tại) — cấm silent-swap. Không có row ⇒ mặc định DEFAULT_MODEL.
model AiAgentModel {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  agent    String
  model    String
  note     String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, agent])
  @@map("ai_agent_model")
}

// [Last-mile Lát 4] Bằng chứng "model X đã chạy TOÀN BỘ golden suite của agent Y VÀ
// đạt launch bar" — APPEND-ONLY (chuẩn ai_learning_signal/ai_interaction, không sửa/xoá
// được kể cả owner). runIds = aiEvalRun.id[] thực sự đã chạy (bằng chứng, không suy diễn).
// expiresAt tính SẴN lúc cấp (TTL AI_QUALIFICATION_TTL_DAYS) — đọc không cần job dọn.
model AiModelQualification {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  agent       String
  model       String
  passRate    Decimal  @map("pass_rate") @db.Decimal(4, 3)
  casesTotal  Int      @map("cases_total")
  runIds      Json     @map("run_ids")
  qualifiedAt DateTime @default(now()) @map("qualified_at") @db.Timestamptz(6)
  qualifiedBy String?  @map("qualified_by") @db.Uuid
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(6)
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([tenantId, agent, model])
  @@map("ai_model_qualification")
}

// [P1 Copilot] Phiên hội thoại Copilot + tin nhắn (tenant-bound, RLS).
model AiConversation {
  id         String      @id @db.Uuid
  tenantId   String      @map("tenant_id") @db.Uuid
  userId     String      @map("user_id") @db.Uuid // app_user.id (claim sub)
  title      String
  contextRef Json?       @map("context_ref") // chip ngữ cảnh {tenant, page}
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime?   @map("deleted_at") @db.Timestamptz(6)
  messages   AiMessage[]

  @@index([tenantId, userId, updatedAt])
  @@map("ai_conversation")
}

model AiMessage {
  id             String   @id @db.Uuid
  tenantId       String   @map("tenant_id") @db.Uuid
  conversationId String   @map("conversation_id") @db.Uuid
  role           String // user | assistant
  content        String   @db.Text
  model          String? // 'mock' | 'claude-*'
  toolCalls      Json?    @map("tool_calls") // thẻ tool-call đã hiển thị
  suggestionId   String?  @map("suggestion_id") @db.Uuid // trỏ ai_suggestion (HITL)
  tokensIn       Int?     @map("tokens_in")
  tokensOut      Int?     @map("tokens_out")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id])

  @@index([tenantId, conversationId, createdAt])
  @@map("ai_message")
}

model AiEvalSuite {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  agent    String // agent bị đánh giá: 'config_copilot','kpi_designer'...
  name     String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cases AiEvalCase[]
  runs  AiEvalRun[]

  @@unique([tenantId, agent, name])
  @@map("ai_eval_suite")
}

model AiEvalCase {
  id         String @id @db.Uuid
  tenantId   String @map("tenant_id") @db.Uuid
  suiteId    String @map("suite_id") @db.Uuid
  name       String?
  input      Json // request đưa vào agent (deterministic trên mock)
  expected   Json? // kỳ vọng (tham khảo/so khớp)
  assertions Json? // [{type:'equals'|'contains'|'regex', path, value}]
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  suite AiEvalSuite @relation(fields: [suiteId], references: [id])

  @@index([tenantId, suiteId])
  @@map("ai_eval_case")
}

model AiEvalRun {
  id            String    @id @db.Uuid
  tenantId      String    @map("tenant_id") @db.Uuid
  suiteId       String    @map("suite_id") @db.Uuid
  model         String? // 'mock' cho tới khi có key
  promptVersion String?   @map("prompt_version")
  status        String    @default("running") // running|done|error
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  summary       Json? // {pass,fail,avg_score}
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  version   Int      @default(1)

  suite   AiEvalSuite    @relation(fields: [suiteId], references: [id])
  results AiEvalResult[]

  @@index([tenantId, suiteId])
  @@map("ai_eval_run")
}

// Canvas layout (Spec Config Studio §4.3/§13) — vị trí node kéo–thả cho Org/Process Designer.
// Chỉ là bố cục hiển thị (không phải dữ liệu nghiệp vụ): kind 'org' (ref = tenant) |
// 'process' (ref = process.id). nodes = {nodeId: {x,y}}.
model CanvasLayout {
  id       String @id @db.Uuid
  tenantId String @map("tenant_id") @db.Uuid
  kind     String // 'org' | 'process'
  refId    String @map("ref_id") @db.Uuid
  nodes    Json   @default("{}")
  edges    Json   @default("[]") // dự phòng edge tuỳ biến (routing) — hiện FE chưa dùng
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)

  @@unique([tenantId, kind, refId])
  @@map("canvas_layout")
}

// Policy-as-Code (#2) — Spec Config Studio §4.4/§7: Cedar policy phủ ABAC lên nền RBAC.
// tenant_id NULL = policy global (guardrail nền tảng, chỉ owner/B3 ghi — app KHÔNG ghi được qua RLS).
// Vòng đời: draft (sửa tự do) → active (PolicyGuard enforce) → disabled.
// Kích hoạt yêu cầu config:publish + toàn bộ `tests` PASS (chống hồi quy phân quyền).
model AccessPolicy {
  id         String  @id @db.Uuid
  tenantId   String? @map("tenant_id") @db.Uuid
  name       String
  engine     String  @default("cedar") // cedar | opa (chỉ cedar được hỗ trợ lát này)
  policyText String  @map("policy_text") // nội dung Cedar (permit/forbid + when/unless)
  scope      String? // action-prefix áp dụng ('kpi' ⇒ kpi:*); null = mọi action
  tests      Json    @default("[]") // [{name, principal:{attrs}, action, context, expect:'allow'|'deny'}]
  status     String  @default("draft") // draft|active|disabled
  note       String?
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, name])
  @@index([tenantId, status])
  @@map("access_policy")
}

model AiEvalResult {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  runId       String   @map("run_id") @db.Uuid
  caseId      String   @map("case_id") @db.Uuid
  score       Decimal? @db.Decimal(4, 3)
  passed      Boolean
  judgeOutput Json?    @map("judge_output") // chi tiết từng assertion pass/fail
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  run AiEvalRun @relation(fields: [runId], references: [id])

  @@index([runId])
  @@map("ai_eval_result")
}

// [Lát 4j] Ủy quyền phân cấp — trưởng phòng cấp quyền soạn tác vụ cho nhân viên
// trong phòng mình (Spec Task Dictionary §4.4). Grant = bản ghi vòng đời/audit;
// hiệu lực RBAC materialize qua user_role(staff_author, scope org_unit) cùng tx.
model AuthoringGrant {
  id         String    @id @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  granterId  String    @map("granter_id") @db.Uuid  // trưởng phòng (dept_head)
  granteeId  String    @map("grantee_id") @db.Uuid  // nhân viên được cấp
  orgUnitId  String    @map("org_unit_id") @db.Uuid // phạm vi = phòng của granter
  capability String    @default("taskcell:author")  // allowlist hẹp — enforce trong CODE (F55)
  status     String    @default("active")           // active|revoked
  userRoleId String?   @map("user_role_id") @db.Uuid // user_role đã materialize (revoke đúng bản ghi)
  grantedAt  DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy  String?   @map("revoked_by") @db.Uuid
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  version    Int       @default(1)

  @@index([tenantId, orgUnitId, status])
  @@index([tenantId, granteeId, status])
  @@map("authoring_grant")
}

// [Trục B L4] Impersonation CHỈ ĐỌC có kiểm soát — bảng ghi PHIÊN (bằng chứng), KHÔNG phải
// cơ chế enforce (enforce ở PermissionGuard J11: whitelist quyền đọc khi claim JWT có `act`).
// "Chỉ cập nhật đúng MỘT đường: kết thúc phiên" — trigger DB chặn mọi mutation khác.
model ImpersonationSession {
  id           String    @id @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  actorUserId  String    @map("actor_user_id") @db.Uuid
  targetUserId String    @map("target_user_id") @db.Uuid
  reason       String                                  // ≥20 ký tự — CHECK ở DB, không chỉ validator
  startedAt    DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6) // TTL cứng — JWT cũng exp cùng lúc
  endedAt      DateTime? @map("ended_at") @db.Timestamptz(6)
  endedReason  String?   @map("ended_reason") // manual|expired|target_disabled
  tokenJti     String    @unique @map("token_jti")

  @@index([tenantId, actorUserId])
  @@index([tenantId, targetUserId])
  @@map("impersonation_session")
}

/// [Trục C L0] Sổ đăng ký dữ liệu — nguồn sự thật DUY NHẤT cho "dữ liệu này thuộc nhóm
/// nào, mức phân loại nào, ai là chủ". tenantId NULL = bản chuẩn cấp tập đoàn; đơn vị
/// chỉ SIẾT CHẶT được (trigger data_asset_no_loosen, không phải chỉ validator tầng API).
model DataAsset {
  id             String  @id @db.Uuid
  tenantId       String? @map("tenant_id") @db.Uuid
  code           String
  groupName      String  @map("group_name")
  description    String?
  sourceSystem   String? @map("source_system")
  ownerRole      String  @map("owner_role") // theo VAI TRÒ/KHỐI, không theo tên người
  classification String // public|internal|confidential|restricted
  legalNote      String? @map("legal_note")

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?   @map("created_by") @db.Uuid
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([tenantId, classification])
  @@map("data_asset")
}

/// [Trục C L2] Read model xuyên đơn vị cho tầng quản trị nền tảng (B3).
/// CHỈ số đếm + trạng thái — không tên người, không email, không điểm, không nội dung.
/// Đọc qua `withPlatform()` (GUC `app.platform_read`, KHÔNG set tenant context ⇒ mọi bảng
/// nghiệp vụ trả 0 dòng). Ghi LUÔN tenant-bound: job đi từng đơn vị bằng `withTenant(t)`.
model PlatformSnapshot {
  id         String   @id @db.Uuid
  tenantId   String   @unique @map("tenant_id") @db.Uuid
  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz(6)
  metrics    Json     @default("{}")
  health     String   @default("ok") // ok|warn|alert
  note       String?
  version    Int      @default(1)

  @@map("platform_snapshot")
}

/// [Trục C L1] Sổ nhật ký XUẤT DỮ LIỆU — append-only (K6), RLS tenant-bound.
/// Không thay audit_log: audit_log ghi "ai làm hành động gì", export_log trả lời câu B0/B5
/// thực sự cần — *dữ liệu nào, mức phân loại gì, đi đâu, bao nhiêu bản ghi*. Bốn cột đó
/// NOT NULL: không có đường ghi vết thiếu.
model ExportLog {
  id                BigInt   @id @default(autoincrement())
  tenantId          String   @map("tenant_id") @db.Uuid
  actorUserId       String   @map("actor_user_id") @db.Uuid
  /// [J11 — chống hồi quy] danh tính BỊ đóng vai (`sub`) nếu lần xuất diễn ra trong phiên đóng
  /// vai; `actorUserId` khi đó là actor THẬT (`act`). J11 cấm mọi hành động khi đóng vai ⇒ mọi
  /// dòng phải NULL; một dòng khác NULL = J11 đã vỡ.
  onBehalfOfUserId  String?  @map("on_behalf_of_user_id") @db.Uuid
  assetCode         String   @map("asset_code")
  classification    String
  destination       String
  destinationKind   String   @map("destination_kind")
  recordCount       Int      @map("record_count")
  route             String
  /// [nối L3] ngoại lệ có hạn cho phép lần xuất này; NULL = đi trong trần mặc định.
  policyExceptionId String?  @map("policy_exception_id") @db.Uuid
  rule              String
  at                DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, at])
  @@index([tenantId, assetCode])
  @@index([tenantId, actorUserId])
  @@map("export_log")
}
