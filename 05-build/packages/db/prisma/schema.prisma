// NHG iPMS — Prisma schema (Phase 0: TDD §6.1–6.2 + audit + feature flag)
// Quy ước TDD §5: id uuid (UUIDv7 sinh app-side), tenant_id mọi bảng nghiệp vụ,
// audit cols created_at/updated_at/created_by/updated_by/version/deleted_at, snake_case.
// RLS được áp qua SQL migration (Prisma không quản lý RLS) — xem migrations/0_init/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @db.Uuid
  code      String   @unique
  nameVi    String   @map("name_vi")
  nameEn    String?  @map("name_en")
  type      String // holding|opco|propco
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  orgUnits     OrgUnit[]
  persons      Person[]
  positions    Position[]
  roleFamilies RoleFamily[]
  appUsers     AppUser[]
  userRoles    UserRole[]

  @@map("tenant")
}

model OrgUnit {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  code      String
  nameVi    String   @map("name_vi")
  nameEn    String?  @map("name_en")
  level     String // group|bu|department|team
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  parent    OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children  OrgUnit[] @relation("OrgUnitTree")
  positions Position[]
  persons   Person[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@map("org_unit")
}

model RoleFamily {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  nameVi    String   @map("name_vi")
  nameEn    String?  @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  positions Position[]

  @@unique([tenantId, code])
  @@map("role_family")
}

model Position {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  orgUnitId    String  @map("org_unit_id") @db.Uuid
  roleFamilyId String? @map("role_family_id") @db.Uuid
  titleVi      String  @map("title_vi")
  titleEn      String? @map("title_en")
  grade        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orgUnit    OrgUnit     @relation(fields: [orgUnitId], references: [id])
  roleFamily RoleFamily? @relation(fields: [roleFamilyId], references: [id])
  persons    Person[]

  @@map("position")
}

model Person {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeCode    String    @map("employee_code")
  externalId      String?   @map("external_id")
  fullName        String    @map("full_name")
  email           String?
  status          String // active|leave|terminated
  orgUnitId       String?   @map("org_unit_id") @db.Uuid
  positionId      String?   @map("position_id") @db.Uuid
  managerId       String?   @map("manager_id") @db.Uuid
  hireDate        DateTime? @map("hire_date") @db.Date
  seniorityMonths Int?      @map("seniority_months")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  orgUnit  OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])
  manager  Person?   @relation("Reports", fields: [managerId], references: [id])
  reports  Person[]  @relation("Reports")
  appUsers AppUser[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, managerId])
  @@index([tenantId, orgUnitId])
  @@map("person")
}

model AppUser {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  personId         String? @map("person_id") @db.Uuid
  entraOid         String? @unique @map("entra_oid")
  email            String
  isServiceAccount Boolean @default(false) @map("is_service_account")
  status           String  @default("active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  person    Person?    @relation(fields: [personId], references: [id])
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@map("app_user")
}

model Role {
  id           String  @id @db.Uuid
  tenantId     String? @map("tenant_id") @db.Uuid // null = global role
  code         String // employee|manager|dept_head|bu_leader|hrbp|group_hr_admin|exec_viewer|auditor|ai_service|tenant_admin
  nameVi       String? @map("name_vi")
  nameEn       String? @map("name_en")
  isGroupLevel Boolean @default(false) @map("is_group_level")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("role")
}

model Permission {
  id   String @id @db.Uuid
  code String @unique // 'goal:update','rating:approve','org:read'...

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  appUserId String  @map("app_user_id") @db.Uuid
  roleId    String  @map("role_id") @db.Uuid
  scopeType String  @default("self") @map("scope_type") // tenant|org_unit|self — [F33] NOT NULL, default hẹp nhất (fail-closed)
  scopeId   String? @map("scope_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  appUser AppUser @relation(fields: [appUserId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@index([tenantId, appUserId])
  @@map("user_role")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String // 'org_unit.create','person.update'...
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, at])
  @@map("audit_log")
}

model FeatureFlag {
  id        String   @id @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid // null = global default
  key       String
  enabled   Boolean  @default(false)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@unique([tenantId, key])
  @@map("feature_flag")
}

// ===== Phase 1 — Chiến lược & mục tiêu (TDD §6.3) =====

enum GoalStatus {
  draft
  active
  at_risk
  off_track
  done
  cancelled

  @@map("goal_status")
}

enum ObjectiveKind {
  okr
  kgi

  @@map("objective_kind")
}

model StrategicTheme {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String?
  nameVi   String  @map("name_vi")
  nameEn   String? @map("name_en")
  period   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  objectives Objective[]

  @@map("strategic_theme")
}

model Objective {
  id        String        @id @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  kind      ObjectiveKind
  themeId   String?       @map("theme_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  orgUnitId String?       @map("org_unit_id") @db.Uuid
  ownerId   String?       @map("owner_id") @db.Uuid
  nameVi    String        @map("name_vi")
  nameEn    String?       @map("name_en")
  period    String
  weight    Decimal?      @db.Decimal(5, 2)
  status    GoalStatus    @default(draft)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  theme    StrategicTheme? @relation(fields: [themeId], references: [id])
  parent   Objective?      @relation("ObjectiveTree", fields: [parentId], references: [id])
  children Objective[]     @relation("ObjectiveTree")
  goals    Goal[]

  @@index([tenantId, kind])
  @@map("objective")
}

model Goal {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  objectiveId  String?    @map("objective_id") @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  orgUnitId    String?    @map("org_unit_id") @db.Uuid
  nameVi       String     @map("name_vi")
  nameEn       String?    @map("name_en")
  description  String?
  period       String
  weight       Decimal?   @db.Decimal(5, 2)
  parentGoalId String?    @map("parent_goal_id") @db.Uuid
  status       GoalStatus @default(draft)
  healthScore  Decimal?   @map("health_score") @db.Decimal(5, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  objective  Objective? @relation(fields: [objectiveId], references: [id])
  parentGoal Goal?      @relation("GoalTree", fields: [parentGoalId], references: [id])
  childGoals Goal[]     @relation("GoalTree")

  @@index([tenantId, ownerId, period])
  @@map("goal")
}

// ===== Phase 1 — KPI & Scorecard (TDD §6.4) =====

model KpiCategory {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  type     String // skill_hard|skill_soft|problem_solving|attitude|result
  nameVi   String  @map("name_vi")
  nameEn   String? @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent   KpiCategory?  @relation("KpiCategoryTree", fields: [parentId], references: [id])
  children KpiCategory[] @relation("KpiCategoryTree")
  kpis     Kpi[]

  @@map("kpi_category")
}

model KpiFormula {
  id         String  @id @db.Uuid
  tenantId   String  @map("tenant_id") @db.Uuid
  expression String // parser whitelist: min,max,round,clamp,if · biến: actual,target,base
  params     Json    @default("{}")
  version    Int     @default(1)
  note       String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  kpis Kpi[]

  @@map("kpi_formula")
}

model Kpi {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  categoryId       String? @map("category_id") @db.Uuid
  code             String
  nameVi           String  @map("name_vi")
  nameEn           String? @map("name_en")
  definition       String?
  method           String // manual | system
  direction        String // forward | reverse
  formulaId        String? @map("formula_id") @db.Uuid
  dataSource       String? @map("data_source")
  unit             String?
  frequency        String // weekly|monthly|quarterly|yearly
  evidenceRequired Boolean @default(true) @map("evidence_required")
  riskLevel        String? @map("risk_level")
  kpiVersion       Int     @default(1) @map("kpi_version")
  status           String  @default("draft") // draft|pending_approval|active|deprecated
  approvalOwnerId  String? @map("approval_owner_id") @db.Uuid
  taskCellRef      String? @map("task_cell_ref")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  category       KpiCategory?       @relation(fields: [categoryId], references: [id])
  formula        KpiFormula?        @relation(fields: [formulaId], references: [id])
  scoreTiers     KpiScoreTier[]
  applicability  KpiApplicability[]
  scorecardItems ScorecardItem[]

  @@unique([tenantId, code, kpiVersion])
  @@map("kpi")
}

model KpiScoreTier {
  id              String  @id @db.Uuid
  tenantId        String  @map("tenant_id") @db.Uuid
  kpiId           String? @map("kpi_id") @db.Uuid
  scorecardItemId String? @map("scorecard_item_id") @db.Uuid
  minPct          Decimal @map("min_pct") @db.Decimal(5, 2)
  score           Decimal @db.Decimal(6, 2)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  kpi Kpi? @relation(fields: [kpiId], references: [id])

  @@index([tenantId, kpiId])
  @@map("kpi_score_tier")
}

model KpiApplicability {
  id                 String  @id @db.Uuid
  tenantId           String  @map("tenant_id") @db.Uuid
  kpiId              String  @map("kpi_id") @db.Uuid
  positionId         String? @map("position_id") @db.Uuid
  roleFamilyId       String? @map("role_family_id") @db.Uuid
  minSeniorityMonths Int?    @map("min_seniority_months")
  personStatus       String? @map("person_status")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  kpi Kpi @relation(fields: [kpiId], references: [id])

  @@map("kpi_applicability")
}

model Scorecard {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  nameVi       String  @map("name_vi")
  nameEn       String? @map("name_en")
  roleFamilyId String? @map("role_family_id") @db.Uuid
  orgUnitId    String? @map("org_unit_id") @db.Uuid
  period       String?
  status       String  @default("draft")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  items ScorecardItem[]

  @@map("scorecard")
}

// ===== Phase 2 — Check-in (TDD §6.6) =====

model Checkin {
  id             String  @id @db.Uuid
  tenantId       String  @map("tenant_id") @db.Uuid
  personId       String  @map("person_id") @db.Uuid
  cadence        String // weekly|monthly|quarterly|yearly
  periodKey      String  @map("period_key") // '2026-W26','2026-07'
  progressNote   String? @map("progress_note")
  blocker        String?
  managerComment String? @map("manager_comment")
  status         String  @default("open") // open|submitted|reviewed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  goalUpdates CheckinGoalUpdate[]

  @@unique([tenantId, personId, cadence, periodKey])
  @@map("checkin")
}

model CheckinGoalUpdate {
  id          String  @id @db.Uuid
  tenantId    String  @map("tenant_id") @db.Uuid
  checkinId   String  @map("checkin_id") @db.Uuid
  goalId      String  @map("goal_id") @db.Uuid
  progressPct Decimal @map("progress_pct") @db.Decimal(5, 2)
  note        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  checkin Checkin @relation(fields: [checkinId], references: [id])

  @@map("checkin_goal_update")
}

// ===== Phase 2 — Review & Rating (TDD §6.7) =====

enum ReviewStatus {
  draft
  self_done
  manager_done
  calibrated
  final
  appealed

  @@map("review_status")
}

model ReviewCycle {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  name      String
  period    String
  startDate DateTime? @map("start_date") @db.Date
  endDate   DateTime? @map("end_date") @db.Date
  status    String  @default("planned") // planned|open|closed
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  reviews Review[]

  @@map("review_cycle")
}

model Review {
  id                String       @id @db.Uuid
  tenantId          String       @map("tenant_id") @db.Uuid
  cycleId           String       @map("cycle_id") @db.Uuid
  revieweeId        String       @map("reviewee_id") @db.Uuid
  scorecardId       String?      @map("scorecard_id") @db.Uuid
  selfReflection    String?      @map("self_reflection")
  managerAssessment String?      @map("manager_assessment")
  strengths         String?
  gaps              String?
  developmentNeeds  String?      @map("development_needs")
  proposedRating    String?      @map("proposed_rating")
  finalRating       String?      @map("final_rating")
  finalRationale    String?      @map("final_rationale") // [F38] explainable — lý do duyệt lưu trên review
  finalScore        Decimal?     @map("final_score") @db.Decimal(6, 2)
  ipcGrade          String?      @map("ipc_grade")
  status            ReviewStatus @default(draft)
  approvedBy        String?      @map("approved_by") @db.Uuid
  approvedAt        DateTime?    @map("approved_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  cycle      ReviewCycle       @relation(fields: [cycleId], references: [id])
  itemScores ReviewItemScore[]

  @@unique([tenantId, cycleId, revieweeId])
  @@map("review")
}

model ReviewItemScore {
  id              String   @id @db.Uuid
  tenantId        String   @map("tenant_id") @db.Uuid
  reviewId        String   @map("review_id") @db.Uuid
  scorecardItemId String   @map("scorecard_item_id") @db.Uuid
  raterId         String?  @map("rater_id") @db.Uuid
  actualValue     Decimal? @map("actual_value") @db.Decimal(14, 4)
  targetValue     Decimal? @map("target_value") @db.Decimal(14, 4) // [F26/F38] snapshot target — recompute được achievedPct
  achievedPct     Decimal? @map("achieved_pct") @db.Decimal(6, 2)
  rawScore        Decimal? @map("raw_score") @db.Decimal(6, 2)
  weightedScore   Decimal? @map("weighted_score") @db.Decimal(6, 2)
  source          String? // system|manual
  formulaVersion  Int?     @map("formula_version") // snapshot — recompute đúng version (explainable)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  review Review @relation(fields: [reviewId], references: [id])

  @@map("review_item_score")
}

// ===== Phase 2 — Calibration (TDD §6.8) =====

model CalibrationSession {
  id          String    @id @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  cycleId     String?   @map("cycle_id") @db.Uuid
  orgUnitId   String?   @map("org_unit_id") @db.Uuid
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  status      String    @default("planned") // planned|running|done
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  decisions CalibrationDecision[]

  @@map("calibration_session")
}

model CalibrationDecision {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  sessionId    String  @map("session_id") @db.Uuid
  reviewId     String  @map("review_id") @db.Uuid
  ratingBefore String? @map("rating_before")
  ratingAfter  String? @map("rating_after")
  rationale    String // BẮT BUỘC — explainable
  decidedBy    String? @map("decided_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  session CalibrationSession @relation(fields: [sessionId], references: [id])

  @@map("calibration_decision")
}

// ===== Phase 1 — Task Evidence Hub (TDD §6.5) =====

enum EvidenceStatus {
  pending
  verified
  rejected
  duplicated

  @@map("evidence_status")
}

model Evidence {
  id              String         @id @db.Uuid
  tenantId        String         @map("tenant_id") @db.Uuid
  type            String // task|milestone|document|approval|ticket|sla|feedback|metric|ai_log
  ownerId         String?        @map("owner_id") @db.Uuid
  relatedGoalId   String?        @map("related_goal_id") @db.Uuid
  relatedKpiId    String?        @map("related_kpi_id") @db.Uuid
  taskCellRef     String?        @map("task_cell_ref")
  sourceSystem    String         @map("source_system") // notion|sis|crm|hris|manual|csv...
  externalId      String?        @map("external_id")
  uri             String?
  payload         Json?
  occurredAt      DateTime?      @map("occurred_at") @db.Timestamptz(6)
  status          EvidenceStatus @default(pending)
  reviewerId      String?        @map("reviewer_id") @db.Uuid
  confidentiality String         @default("internal") // public|internal|restricted|secret
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceSystem, externalId])
  @@index([tenantId, relatedKpiId])
  @@index([tenantId, ownerId, occurredAt])
  @@map("evidence")
}

model ScorecardItem {
  id          String   @id @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  scorecardId String   @map("scorecard_id") @db.Uuid
  kpiId       String   @map("kpi_id") @db.Uuid
  groupLabel  String?  @map("group_label")
  weight      Decimal? @db.Decimal(5, 2)
  groupWeight Decimal? @map("group_weight") @db.Decimal(5, 2)
  target      Decimal? @db.Decimal(14, 4) // [F26] target SERVER-SIDE — compute không nhận từ client
  base        Decimal? @db.Decimal(14, 4)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  scorecard Scorecard @relation(fields: [scorecardId], references: [id])
  kpi       Kpi       @relation(fields: [kpiId], references: [id])

  @@index([tenantId, scorecardId])
  @@map("scorecard_item")
}
