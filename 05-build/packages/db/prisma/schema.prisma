// NHG iPMS — Prisma schema (Phase 0: TDD §6.1–6.2 + audit + feature flag)
// Quy ước TDD §5: id uuid (UUIDv7 sinh app-side), tenant_id mọi bảng nghiệp vụ,
// audit cols created_at/updated_at/created_by/updated_by/version/deleted_at, snake_case.
// RLS được áp qua SQL migration (Prisma không quản lý RLS) — xem migrations/0_init/migration.sql.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @db.Uuid
  code      String   @unique
  nameVi    String   @map("name_vi")
  nameEn    String?  @map("name_en")
  type      String // holding|opco|propco
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  orgUnits     OrgUnit[]
  persons      Person[]
  positions    Position[]
  roleFamilies RoleFamily[]
  appUsers     AppUser[]
  userRoles    UserRole[]

  @@map("tenant")
}

model OrgUnit {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  code      String
  nameVi    String   @map("name_vi")
  nameEn    String?  @map("name_en")
  level     String // group|bu|department|team
  configVersionId String? @map("config_version_id") @db.Uuid // Config Studio §4.3
  grade           String? // cấp bậc đơn vị (tuỳ chọn)
  // [Trục B L3] Người quản lý đơn vị — cột thô (như createdBy/updatedBy), KHÔNG khai
  // Prisma relation object: person.manager đã là self-relation "Reports" (quản lý TRỰC
  // TIẾP một người khác) — đây là khái niệm KHÁC (một người đứng đầu một ĐƠN VỊ), validate
  // ở tầng service, không ràng buộc FK cứng để tránh xung đột tên quan hệ.
  managerId       String? @map("manager_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  parent    OrgUnit?  @relation("OrgUnitTree", fields: [parentId], references: [id])
  children  OrgUnit[] @relation("OrgUnitTree")
  positions Position[]
  persons   Person[]

  @@unique([tenantId, code])
  @@index([tenantId, parentId])
  @@map("org_unit")
}

model RoleFamily {
  id        String   @id @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  code      String
  nameVi    String   @map("name_vi")
  nameEn    String?  @map("name_en")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  positions Position[]

  @@unique([tenantId, code])
  @@map("role_family")
}

model Position {
  id           String  @id @db.Uuid
  tenantId     String  @map("tenant_id") @db.Uuid
  orgUnitId    String  @map("org_unit_id") @db.Uuid
  roleFamilyId String? @map("role_family_id") @db.Uuid
  titleVi      String  @map("title_vi")
  titleEn      String? @map("title_en")
  grade        String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  orgUnit    OrgUnit     @relation(fields: [orgUnitId], references: [id])
  roleFamily RoleFamily? @relation(fields: [roleFamilyId], references: [id])
  persons    Person[]

  @@map("position")
}

model Person {
  id              String    @id @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  employeeCode    String    @map("employee_code")
  externalId      String?   @map("external_id")
  fullName        String    @map("full_name")
  email           String?
  status          String // active|leave|terminated
  orgUnitId       String?   @map("org_unit_id") @db.Uuid
  positionId      String?   @map("position_id") @db.Uuid
  managerId       String?   @map("manager_id") @db.Uuid
  hireDate        DateTime? @map("hire_date") @db.Date
  seniorityMonths Int?      @map("seniority_months")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  orgUnit  OrgUnit?  @relation(fields: [orgUnitId], references: [id])
  position Position? @relation(fields: [positionId], references: [id])
  manager  Person?   @relation("Reports", fields: [managerId], references: [id])
  reports  Person[]  @relation("Reports")
  appUsers AppUser[]

  @@unique([tenantId, employeeCode])
  @@index([tenantId, managerId])
  @@index([tenantId, orgUnitId])
  @@map("person")
}

model AppUser {
  id               String  @id @db.Uuid
  tenantId         String  @map("tenant_id") @db.Uuid
  personId         String? @map("person_id") @db.Uuid
  entraOid         String? @unique @map("entra_oid")
  email            String
  isServiceAccount Boolean @default(false) @map("is_service_account")
  status           String  @default("active")
  // [Trục B L1] Tuỳ chọn cá nhân (VI/EN · sáng/tối · mật độ) — cột rẻ hơn một bảng mới,
  // whitelist key ở tầng service (giữ nguyên khuôn tenant.settings jsonb).
  preferences      Json    @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  person    Person?    @relation(fields: [personId], references: [id])
  userRoles UserRole[]

  @@unique([tenantId, email])
  @@map("app_user")
}

// [Trục B L1] Thông báo cá nhân — bảng MỚI DUY NHẤT của lát này (event × channel × enabled).
// Không có row = coi như TẤT CẢ đều bật (mặc định an toàn cho người mới); PATCH chỉ upsert
// các dòng người dùng chủ động tắt/bật, không cần seed sẵn ma trận đầy đủ.
model NotificationSetting {
  tenantId  String   @map("tenant_id") @db.Uuid
  appUserId String   @map("app_user_id") @db.Uuid
  eventKey  String   @map("event_key")  // vd 'review.finalized' | 'checkin.due' | 'task.feedback'
  channel   String                       // 'in_app' | 'email'
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@id([appUserId, eventKey, channel])
  @@index([tenantId, appUserId])
  @@map("notification_setting")
}

model Role {
  id           String  @id @db.Uuid
  tenantId     String? @map("tenant_id") @db.Uuid // null = global role
  code         String // employee|manager|dept_head|bu_leader|hrbp|group_hr_admin|exec_viewer|auditor|ai_service|tenant_admin
  nameVi       String? @map("name_vi")
  nameEn       String? @map("name_en")
  isGroupLevel Boolean @default(false) @map("is_group_level")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, code])
  @@map("role")
}

model Permission {
  id   String @id @db.Uuid
  code String @unique // 'goal:update','rating:approve','org:read'...

  rolePermissions RolePermission[]

  @@map("permission")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id        String  @id @db.Uuid
  tenantId  String  @map("tenant_id") @db.Uuid
  appUserId String  @map("app_user_id") @db.Uuid
  roleId    String  @map("role_id") @db.Uuid
  scopeType String  @default("self") @map("scope_type") // tenant|org_unit|self — [F33] NOT NULL, default hẹp nhất (fail-closed)
  scopeId   String? @map("scope_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  // [Trục B L1] "ai cấp" — GET /admin/users/:id/effective-access phải trả được nguồn của
  // từng quyền. Trước lát này UserRole không có createdBy/revokedBy → không truy được ai
  // đã gán một vai cho ai (chỉ biết KHI nào qua createdAt). NULL hợp lệ cho grant do seed
  // dựng sẵn (không có actor thật).
  createdBy String?   @map("created_by") @db.Uuid
  revokedBy String?   @map("revoked_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)
  /// [Trục C L3 — K4] Vai TẠM: hết hạn là tự rụng, kiểm TẠI CỬA mỗi request
  /// (`PermissionGuard`), job dọn chỉ là dọn dẹp. NULL = vai thường, không hạn.
  /// Trigger `user_role_no_extend` chặn kéo dài kể cả bằng UPDATE thẳng vào DB.
  expiresAt DateTime? @map("expires_at") @db.Timestamptz(6)
  /// Ngoại lệ đã sinh ra vai tạm này — truy ngược "ai duyệt cho người này quyền lạ đó".
  policyExceptionId String? @map("policy_exception_id") @db.Uuid

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  appUser AppUser @relation(fields: [appUserId], references: [id])
  role    Role    @relation(fields: [roleId], references: [id])

  @@index([tenantId, appUserId])
  @@map("user_role")
}

/// [Trục C L5] Thời hạn lưu trữ theo NHÓM DỮ LIỆU (gắn `data_asset.code`, không gắn tên bảng).
/// `tenantId` NULL = bản chuẩn tập đoàn; đơn vị chỉ RÚT NGẮN được (trigger `retention_policy_no_extend`).
/// K6 ở tầng DB: không lưu được chính sách `hard_delete`/`anonymize` cho `audit.log`/`export.log`.
model RetentionPolicy {
  id              String  @id @db.Uuid
  tenantId        String? @map("tenant_id") @db.Uuid
  assetCode       String  @map("asset_code")
  retentionMonths Int     @map("retention_months")
  action          String // hard_delete|anonymize|cold_archive|keep
  legalBasis      String? @map("legal_basis")
  note            String?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedBy String?   @map("updated_by") @db.Uuid
  version   Int       @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@map("retention_policy")
}

/// [Trục C L5] Sổ các lượt quét lưu trữ. Vừa là hồ sơ tuân thủ, vừa là ĐIỀU KIỆN được chạy
/// thật: `mode='apply'` bắt buộc trỏ tới một lượt `dry_run` còn hạn và cùng `planHash` (CHECK
/// ở DB). `skippedProtected` đếm bản ghi quá hạn nhưng thuộc kỳ chưa chốt (K7).
model RetentionRun {
  id               String @id @db.Uuid
  tenantId         String @map("tenant_id") @db.Uuid
  mode             String // dry_run|apply
  assetCode        String @map("asset_code")
  action           String
  retentionMonths  Int    @map("retention_months")
  cutoffAt         DateTime @map("cutoff_at") @db.Timestamptz(6)
  plannedCount     Int    @default(0) @map("planned_count")
  affectedCount    Int    @default(0) @map("affected_count")
  skippedProtected Int    @default(0) @map("skipped_protected")
  planHash         String @map("plan_hash")
  dryRunId         String? @map("dry_run_id") @db.Uuid
  report           Json   @default("{}")
  actorUserId      String @map("actor_user_id") @db.Uuid
  startedAt        DateTime @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz(6)

  @@index([tenantId, startedAt])
  @@map("retention_run")
}

/// [Trục C L4 — K8] Cờ rủi ro SINH TỰ ĐỘNG từ sự kiện đã có (audit_log, ai_interaction).
/// Không có màn nhập tay: sổ rủi ro nhập tay đo sự chăm chỉ của người nhập, không đo rủi ro.
/// `(tenantId, sourceType, sourceRef)` UNIQUE ⇒ bộ sinh chạy lại bao nhiêu lần cũng không nhân bản.
/// Nội dung BẤT BIẾN (trigger) — chỉ `incidentId` đổi được.
model RiskFlag {
  id          String @id @db.Uuid
  tenantId    String @map("tenant_id") @db.Uuid
  kind        String
  severity    String // low|medium|high
  sourceType  String @map("source_type") // audit_log|ai_interaction
  sourceRef   String @map("source_ref")
  actorUserId String? @map("actor_user_id") @db.Uuid
  summary     String
  detail      Json   @default("{}")
  occurredAt  DateTime @map("occurred_at") @db.Timestamptz(6)
  incidentId  String? @map("incident_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, sourceType, sourceRef])
  @@index([tenantId, occurredAt])
  @@map("risk_flag")
}

/// [Trục C L4] Sự cố: mở → điều tra → khắc phục → đóng. Trạng thái đi MỘT CHIỀU (trigger);
/// đóng BẮT BUỘC có nguyên nhân gốc ≥20 ký tự + người đóng + mốc đóng (CHECK constraint).
model Incident {
  id             String @id @db.Uuid
  tenantId       String @map("tenant_id") @db.Uuid
  title          String
  severity       String
  status         String @default("open")
  assigneeUserId String? @map("assignee_user_id") @db.Uuid
  openedBy       String @map("opened_by") @db.Uuid
  openedAt       DateTime @default(now()) @map("opened_at") @db.Timestamptz(6)
  closedAt       DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy       String? @map("closed_by") @db.Uuid
  rootCause      String? @map("root_cause")
  note           String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@index([tenantId, status])
  @@map("incident")
}

/// [Trục C L3] Ngoại lệ chính sách CÓ THỜI HẠN — đường nới quyền hợp lệ duy nhất.
/// K4: trần 72h (đơn vị hạ được, không nâng), không gia hạn (trigger chặn), hết hạn tự rụng.
/// K5: người duyệt ≠ người xin ≠ người nhận. Mỗi lần DÙNG → audit + đếm (nối cờ rủi ro L4).
model PolicyException {
  id              String @id @db.Uuid
  tenantId        String @map("tenant_id") @db.Uuid
  requesterUserId String @map("requester_user_id") @db.Uuid
  granteeUserId   String @map("grantee_user_id") @db.Uuid
  permissionCode  String @map("permission_code")
  scopeType       String @default("tenant") @map("scope_type")
  scopeId         String? @map("scope_id") @db.Uuid
  reason          String
  requestedAt     DateTime @default(now()) @map("requested_at") @db.Timestamptz(6)
  /// Do NGƯỜI DUYỆT chốt lúc duyệt ⇒ NULL khi còn `pending`.
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  status          String @default("pending") // pending|approved|rejected|revoked|expired
  approverUserId  String? @map("approver_user_id") @db.Uuid
  decidedAt       DateTime? @map("decided_at") @db.Timestamptz(6)
  decisionNote    String? @map("decision_note")
  usedCount       Int @default(0) @map("used_count")
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@index([tenantId, status])
  @@index([granteeUserId])
  @@map("policy_exception")
}

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  tenantId    String   @map("tenant_id") @db.Uuid
  actorUserId String?  @map("actor_user_id") @db.Uuid
  action      String // 'org_unit.create','person.update'...
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id") @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  at          DateTime @default(now()) @db.Timestamptz(6)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, at])
  @@map("audit_log")
}

model FeatureFlag {
  id        String   @id @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid // null = global default
  key       String
  enabled   Boolean  @default(false)
  payload   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  version   Int      @default(1)

  @@unique([tenantId, key])
  @@map("feature_flag")
}

// ===== Phase 1 — Chiến lược & mục tiêu (TDD §6.3) =====

enum GoalStatus {
  draft
  active
  at_risk
  off_track
  done
  cancelled

  @@map("goal_status")
}

enum ObjectiveKind {
  okr
  kgi

  @@map("objective_kind")
}

model StrategicTheme {
  id       String  @id @db.Uuid
  tenantId String  @map("tenant_id") @db.Uuid
  code     String?
  nameVi   String  @map("name_vi")
  nameEn   String? @map("name_en")
  period   String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  objectives Objective[]

  @@map("strategic_theme")
}

model Objective {
  id        String        @id @db.Uuid
  tenantId  String        @map("tenant_id") @db.Uuid
  kind      ObjectiveKind
  themeId   String?       @map("theme_id") @db.Uuid
  parentId  String?       @map("parent_id") @db.Uuid
  orgUnitId String?       @map("org_unit_id") @db.Uuid
  ownerId   String?       @map("owner_id") @db.Uuid
  nameVi    String        @map("name_vi")
  nameEn    String?       @map("name_en")
  period    String
  weight    Decimal?      @db.Decimal(5, 2)
  status    GoalStatus    @default(draft)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy String?  @map("created_by") @db.Uuid
  updatedBy String?  @map("updated_by") @db.Uuid
  version   Int      @default(1)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(6)

  theme    StrategicTheme? @relation(fields: [themeId], references: [id])
  parent   Objective?      @relation("ObjectiveTree", fields: [parentId], references: [id])
  children Objective[]     @relation("ObjectiveTree")
  goals    Goal[]

  @@index([tenantId, kind])
  @@map("objective")
}

model Goal {
  id           String     @id @db.Uuid
  tenantId     String     @map("tenant_id") @db.Uuid
  objectiveId  String?    @map("objective_id") @db.Uuid
  ownerId      String     @map("owner_id") @db.Uuid
  orgUnitId    String?    @map("org_unit_id") @db.Uuid
  nameVi       String     @map("name_vi")
  nameEn       String?    @map("name_en")
  description  String?
  period       String
  weight       Decimal?   @db.Decimal(5, 2)
  parentGoalId String?    @map("parent_goal_id") @db.Uuid
  status       GoalStatus @default(draft)
  healthScore  Decimal?   @map("health_score") @db.Decimal(5, 2)
