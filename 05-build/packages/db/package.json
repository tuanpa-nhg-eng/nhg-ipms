{
  "name": "@ipms/db",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo 'lint: db ok'",
    "test": "echo 'unit: db (covered by api integration)'",
    "generate": "prisma generate",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "ts-node --transpile-only src/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@ipms/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
